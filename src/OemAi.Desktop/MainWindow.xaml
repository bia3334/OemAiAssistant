<Window x:Class="OemAi.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:OemAi.Desktop.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="OEM AI Assistant" Height="680" Width="1080" MinWidth="820" MinHeight="520"
        Background="#F3F4F6" FontFamily="Segoe UI Variable, Segoe UI" FontSize="14"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="BorderBrush" Value="#E5E7EB" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B7280" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,14,0,4" />
        </Style>
        <Style x:Key="Meter" TargetType="ProgressBar">
            <Setter Property="Height" Value="8" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Foreground" Value="#2563EB" />
            <Setter Property="Background" Value="#E5E7EB" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Device telemetry panel ===== -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Thiết bị OEM" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Telemetry.Manufacturer}" Margin="0,6,0,0" FontSize="12" Foreground="#6B7280" />
                <TextBlock Text="{Binding Telemetry.DeviceModel, FallbackValue='Đang đọc…'}"
                           Margin="0,2,0,0" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="#111827" />
                <TextBlock Text="{Binding Telemetry.OsVersion}" Foreground="#6B7280" FontSize="12" TextWrapping="Wrap" />

                <TextBlock Style="{StaticResource Label}"
                           Text="{Binding Telemetry.CpuUsagePercent, StringFormat='CPU  {0:F0}%'}" />
                <ProgressBar Style="{StaticResource Meter}" Value="{Binding Telemetry.CpuUsagePercent, Mode=OneWay}" />

                <TextBlock Style="{StaticResource Label}"
                           Text="{Binding Telemetry.RamUsagePercent, StringFormat='RAM  {0:F0}%'}" />
                <ProgressBar Style="{StaticResource Meter}" Value="{Binding Telemetry.RamUsagePercent, Mode=OneWay}" />
                <TextBlock FontSize="12" Foreground="#6B7280" Margin="0,4,0,0">
                    <Run Text="{Binding Telemetry.RamUsedGb, Mode=OneWay, StringFormat='{}{0:F1}'}" /> /
                    <Run Text="{Binding Telemetry.RamTotalGb, Mode=OneWay, StringFormat='{}{0:F1} GB'}" />
                </TextBlock>

                <TextBlock Style="{StaticResource Label}"
                           Text="{Binding Telemetry.BatteryPercent, StringFormat='Pin  {0}%'}" />
                <ProgressBar Style="{StaticResource Meter}" Foreground="#16A34A"
                             Value="{Binding Telemetry.BatteryPercent, Mode=OneWay}" />
                <TextBlock Text="⚡ Đang sạc" FontSize="12" Foreground="#16A34A" Margin="0,4,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Telemetry.IsCharging}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Margin="0,18,0,0" FontSize="11" Foreground="#9CA3AF"
                           Text="{Binding Telemetry.CapturedAt, StringFormat='Cập nhật lúc {0:HH:mm:ss}'}" />
            </StackPanel>
        </Border>

        <!-- ===== AI chat panel ===== -->
        <Border Grid.Column="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Cuộc trò chuyện mới" Padding="12,4"
                            Command="{Binding NewChatCommand}" />
                    <TextBlock Text="Trợ lý AI" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>

                <ListBox x:Name="ChatList" Grid.Row="1" Margin="0,12" BorderThickness="0"
                         ItemsSource="{Binding Messages}" HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ChatMessage}">
                            <Border x:Name="Bubble" Margin="0,4,80,4" Padding="12,8" CornerRadius="10"
                                    Background="#F3F4F6" HorizontalAlignment="Left">
                                <StackPanel>
                                    <TextBlock Text="{Binding Author}" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" />
                                    <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                             BorderThickness="0" Background="Transparent" Padding="0" Margin="0,2,0,0" />
                                    <TextBlock FontSize="10" Foreground="#9CA3AF"
                                               Text="{Binding Elapsed, StringFormat='phản hồi trong {0:s\\.f}s', TargetNullValue=''}" />
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsUser}" Value="True">
                                    <Setter TargetName="Bubble" Property="Background" Value="#DBEAFE" />
                                    <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right" />
                                    <Setter TargetName="Bubble" Property="Margin" Value="80,4,0,4" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Loading indicator bound straight to AsyncRelayCommand.IsRunning -->
                <StackPanel Grid.Row="2" Margin="0,0,0,10"
                            Visibility="{Binding AskCommand.IsRunning, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="AI đang phân tích telemetry…" Foreground="#2563EB" FontSize="12" Margin="0,0,0,4" />
                    <ProgressBar IsIndeterminate="True" Height="4" BorderThickness="0" />
                </StackPanel>

                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding Question, UpdateSourceTrigger=PropertyChanged}"
                             Padding="10,8" VerticalContentAlignment="Center"
                             AutomationProperties.Name="Câu hỏi cho AI">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding AskCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Grid.Column="1" Content="Gửi" Margin="8,0,0,0" Padding="20,8"
                            Command="{Binding AskCommand}" />
                    <Button Grid.Column="2" Content="Huỷ" Margin="8,0,0,0" Padding="16,8"
                            Command="{Binding AskCancelCommand}"
                            Visibility="{Binding AskCommand.IsRunning, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
